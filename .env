# ─── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8080
ENV=development

# ─── Session store ────────────────────────────────────────────────────────────
# MODE B: postgres (DB in Docker, Go server runs locally)
STORE=postgres

# ─── Database (PostgreSQL running in Docker) ──────────────────────────────────
# DB_HOST=localhost because Go runs on your machine, not inside Docker
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=challengelabs
DB_SSLMODE=disable

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=challengelabs-super-secret-key-change-in-prod-2024
JWT_EXPIRY_HOURS=24

# ─── Docker (challenge containers) ───────────────────────────────────────────
# Leave empty — Go will use the default Docker socket automatically
# DOCKER_HOST=
CONTAINER_MAX_LIFETIME_MINUTES=60
CONTAINER_IDLE_TIMEOUT_MINUTES=15
CONTAINER_MEMORY_LIMIT_MB=512
CONTAINER_CPU_QUOTA=50000

# ─── WebSocket ────────────────────────────────────────────────────────────────
WS_READ_BUFFER_SIZE=4096
WS_WRITE_BUFFER_SIZE=4096

# ─── CORS (your future frontend URLs go here) ─────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── SMTP / Brevo (OTP emails) ────────────────────────────────────────────────
# Get your REST API key from: https://app.brevo.com/settings/keys/api
# Get your SMTP key from: https://app.brevo.com/settings/keys/smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@smtp-brevo.com
SMTP_PASSWORD=your-smtp-password-here
SMTP_FROM=noreply@yourdomain.com

# Brevo REST API key (required for OTP emails) — xkeysib-...
BREVO_API_KEY=your-brevo-api-key-here
